# JLPT N1 Master — environment configuration
#
# Nothing in this file is required to run the app. With no variables set,
# the app runs entirely in Demo Mode: a local, in-browser Zustand store
# (persisted to localStorage) seeded with realistic sample progress over a
# real 60-word N1 vocabulary corpus, and a deterministic mock AI provider.
# Just run `npm install && npm run dev` — no keys needed.
#
# Fill these in only when you're ready to move off demo data.

# --- Supabase (optional — Postgres + Auth backend) ---------------------
# Leave both unset to stay in Demo Mode. Setting BOTH switches the app to
# real persistence + auth (see src/supabase/schema.sql for the schema to
# run in your Supabase project's SQL editor before enabling this).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for privileged operations (e.g. admin scripts,
# server-side seeding). Never expose this to the browser/client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (scaffolded, not yet wired up in this Phase 1 build) --
# The app works fully without this: src/ai/mock-provider.ts deterministically
# derives explanations/examples/quiz content from the structured vocabulary
# data, with zero network calls. src/ai/index.ts's getAiService() factory
# already branches on AI_PROVIDER + the matching key below, but the real
# Anthropic/OpenAI/Gemini provider classes are intentionally left as TODOs
# for a later phase — today every branch still resolves to the mock
# provider. Supported values once implemented: "anthropic" | "openai" | "gemini"
AI_PROVIDER=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
